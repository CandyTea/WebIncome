# Change both passwords before deployment. Do not commit the actual environment file.
WEBINCOME_ADMIN_PASSWORD=replace-with-a-long-admin-password
WEBINCOME_VIEW_PASSWORD=replace-with-a-different-view-password
WEBINCOME_DATA_DIR=/var/lib/webincome
WEBINCOME_SECURE_COOKIE=1
WEBINCOME_TRUST_PROXY=1

# Set to 1 to let anyone with the URL view the data without a password.
# Uploading still requires WEBINCOME_ADMIN_PASSWORD.
WEBINCOME_PUBLIC_VIEW=0

# Optional: lets a local watcher push saved workbooks without logging in.
# Leave empty to disable the /api/sync endpoint.
WEBINCOME_SYNC_TOKEN=replace-with-a-long-random-sync-token
