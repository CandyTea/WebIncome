# Add this location to an existing HTTPS server block for your domain.
# Keep existing certificate paths and HTTPS settings from your server panel.
location / {
    proxy_pass http://127.0.0.1:8765;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 12m;
    proxy_read_timeout 120s;
}

# Do not add a public static-file location for data, workbooks, or .local.
# The Python service checks login and upload permissions for all data routes.
